# PostgreSQL connection string (local PostgreSQL or Neon serverless)
DATABASE_URL=postgresql://user:password@localhost:5432/seed_forge

# Better Auth secret — generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# App URL (http://localhost:3000 in development)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google OAuth — enables Google sign-in + account linking in settings
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=